#!/bin/sh
# Phase 11: Git Pre-Commit Hook for Secret Prevention
# Enforces automated secret detection before allowing any commit to proceed.

echo ">>> [PRE-COMMIT HOOK] Scanning staged repository files for hardcoded secrets..."

node scripts/detect-secrets.js

EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ COMMIT REJECTED: Hardcoded secrets or sensitive credentials detected!"
  echo "Please remove the secrets, load them via environment variables (.env), and re-stage."
  exit 1
fi

echo "✅ Pre-commit secret check passed. Proceeding with commit."
exit 0
