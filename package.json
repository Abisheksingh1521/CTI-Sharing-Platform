{
  "name": "cyber-threat-intelligence-platform",
  "version": "1.0.0",
  "description": "Secure Cyber Threat Intelligence (CTI) Sharing Platform with TLP Enforcement and Tamper-Evident Audit Logging",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:vuln": "node --test --test-concurrency=1 tests/vulnerability/*.test.js",
    "test:fuzz": "node tests/fuzz/iocFuzzer.js",
    "ci": "node scripts/ci-runner.js",
    "security:scan": "node scripts/security-scan.js",
    "audit:verify": "node scripts/verify-audit-chain.js"
  },
  "keywords": [
    "cyber-threat-intelligence",
    "cti",
    "stix2",
    "tlp",
    "secure-software-engineering",
    "audit-chain"
  ],
  "author": "24CYS401 SSE Lab Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
