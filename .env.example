# Environment Configuration Template (DO NOT COMMIT ACTUAL .env WITH SECRETS)
NODE_ENV=development
PORT=3000

# Database Path (Writable Directory)
DB_PATH=./data/cti_platform.sqlite

# Cryptographic Secrets
JWT_SECRET=super_secret_jwt_hmac_sha256_key_change_in_production
JWT_EXPIRES_IN=1h

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
